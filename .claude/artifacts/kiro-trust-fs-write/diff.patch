-        cmd: "kiro-cli chat --no-interactive --trust-tools=fs_read"
+        cmd: "kiro-cli chat --no-interactive --trust-tools=fs_read,fs_write,execute_bash"
         effort_param: flag
         effort_levels: [low, medium, high, xhigh, max]
         effort_flag: "--effort {level}"
